# Supabase project URL — copy from: Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key — copy from: Supabase Dashboard → Settings → API
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# OpenAI API key — https://platform.openai.com/api-keys
# Server-side only (Vercel serverless function) — do NOT prefix with VITE_
# or it will be embedded in the JS bundle and exposed to anyone.
OPENAI_API_KEY=sk-...

# Public URL of your deployed app — used for the shareable public survey link
# e.g. https://your-app.vercel.app  (leave blank to use window.location.origin)
VITE_APP_URL=

# Show "Continue as guest" on the login/signup pages. Also enable
# Supabase Dashboard → Authentication → Sign In / Providers → "Allow anonymous sign-ins".
VITE_ENABLE_GUEST=true

# Cloudflare Turnstile site key (public — safe to commit; it ships in the browser bundle).
# Tokens are verified server-side by Supabase Auth using the widget's SECRET key, which lives only in
# Supabase Dashboard → Authentication → Attack Protection → CAPTCHA (Turnstile). Never put the secret here.
# Optional: the app defaults to this key when unset. Set it to empty only if CAPTCHA protection is OFF
# in Supabase, otherwise every sign-in fails with "captcha_failed".
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAFSAArW1hzd7xNuo

# Resend API key — https://resend.com/api-keys
# Server-side only (Vercel serverless function). Used to send survey notification emails
# to the project owner's account email automatically.
RESEND_API_KEY=re_...

# Supabase service role key — Supabase Dashboard → Settings → API → service_role key
# Server-side only. Used by the notification function to look up the project owner's email.
# NEVER expose this key to the client.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
